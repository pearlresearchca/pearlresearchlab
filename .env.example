# Copy to .env.local and fill in. Never put real values in this file.

# InsForge backend
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=
INSFORGE_URL=
INSFORGE_API_KEY=
NEXT_PUBLIC_APP_URL=

# Gmail for form emails (team notification + thank-you to the sender).
# SMTP_USER: the Gmail / Google Workspace address emails are sent from.
# SMTP_PASSWORD: a 16-character App Password — Google Account → Security →
#   2-Step Verification (must be on) → App passwords. Not your normal password.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
